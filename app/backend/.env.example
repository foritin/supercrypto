# ============================================
# SuperCrypto Backend Environment Configuration
# ============================================
# Copy this file to .env and update with your values

# --------------------------------------------
# Environment
# --------------------------------------------
ENVIRONMENT=dev
DEBUG=true
LOG_LEVEL=INFO

# --------------------------------------------
# Server Configuration
# --------------------------------------------
HOST=0.0.0.0
PORT=8000

# --------------------------------------------
# Database Configuration
# --------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/supercrypto
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=50

# --------------------------------------------
# Security Configuration
# --------------------------------------------
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --------------------------------------------
# Blockchain Configuration
# --------------------------------------------
# RPC URLs
ETHEREUM_RPC_URL=https://eth.llamarpc.com
SEPOLIA_RPC_URL=https://rpc.sepolia.org
HARDHAT_RPC_URL=http://127.0.0.1:8545

# Default network for operations
DEFAULT_NETWORK=hardhat
CHAIN_ID=31337

# --------------------------------------------
# Treasury Multisig Configuration
# --------------------------------------------
# Contract Addresses (update after deployment)
TREASURY_MULTISIG_ADDRESS=0x0000000000000000000000000000000000000000
ADDRESS_PROVIDER_ADDRESS=0x0000000000000000000000000000000000000000

# Treasury Signers (comma-separated addresses)
TREASURY_SIGNERS=0xSigner1...,0xSigner2...,0xSigner3...

# Required signatures threshold (e.g., 2 for 2-of-3)
TREASURY_REQUIRED_SIGNATURES=2

# Treasury Admin/Owner (for emergency operations)
TREASURY_OWNER_ADDRESS=0x0000000000000000000000000000000000000000

# --------------------------------------------
# Token Addresses
# --------------------------------------------
# USDT Contract Address
USDT_ADDRESS=0x0000000000000000000000000000000000000000

# USDC Contract Address  
USDC_ADDRESS=0x0000000000000000000000000000000000000000

# Mock Token Settings (for testing)
ENABLE_MOCK_TOKENS=true

# --------------------------------------------
# Contract Monitoring
# --------------------------------------------
# Event polling interval (seconds)
CONTRACT_POLL_INTERVAL=15

# Confirmation blocks required
CONFIRMATION_BLOCKS=1

# Event retention days
EVENT_RETENTION_DAYS=90

# --------------------------------------------
# Redemption Settings
# --------------------------------------------
# Minimum redemption amount (USDT)
MIN_REDEMPTION_AMOUNT=100

# Maximum redemption amount (USDT)
MAX_REDEMPTION_AMOUNT=1000000

# Redemption processing timeout (hours)
REDEMPTION_TIMEOUT_HOURS=48

# Auto-approve redemption threshold (0 = disabled)
AUTO_APPROVE_THRESHOLD=0

# --------------------------------------------
# External Services
# --------------------------------------------
# Etherscan API (for verification)
ETHERSCAN_API_KEY=your-etherscan-api-key

# Webhook Settings
WEBHOOK_SECRET=your-webhook-secret
WEBHOOK_URL=

# --------------------------------------------
# Notification Settings
# --------------------------------------------
# Email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ADMIN_EMAIL=

# Slack notifications
SLACK_WEBHOOK_URL=

# --------------------------------------------
# Feature Flags
# --------------------------------------------
ENABLE_KYC=true
ENABLE_STAKING=true
ENABLE_LIQUIDITY_MINING=true
ENABLE_REDEMPTION=true

# God Mode (bypass all checks - DEV ONLY!)
GOD_MODE=false

# --------------------------------------------
# Monitoring & Observability
# --------------------------------------------
# Sentry DSN for error tracking
SENTRY_DSN=

# Prometheus metrics
ENABLE_METRICS=true
METRICS_PORT=9090

# Health check settings
HEALTH_CHECK_INTERVAL=30
