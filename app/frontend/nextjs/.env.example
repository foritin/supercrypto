# SuperCrypto 前端环境配置示例
# 复制此文件为 .env.local 并根据需要修改

# ========== 区块链配置 ==========
# Hardhat 开发网络 RPC URL
NEXT_PUBLIC_RPC_URL=http://YOUR_RPC_HOST:8545
# Chain ID
NEXT_PUBLIC_CHAIN_ID=31337

# ========== 后端 API ==========
# 后端 API 地址
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# WebSocket 实时数据地址
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# ========== Web3 钱包配置 ==========
# WalletConnect Project ID (从 https://cloud.walletconnect.com 获取)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-project-id
# 支持的链 ID
NEXT_PUBLIC_SUPPORTED_CHAIN_IDS=31337,1,11155111

# ========== IPFS 配置 ==========
# IPFS 网关地址（用于显示NFT等资源）
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs

# ========== 环境标识 ==========
# 环境类型: local / test / production
NEXT_PUBLIC_ENV=local

# ========== 功能开关 ==========
# 是否启用性能监控
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=true
# 是否启用错误上报
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=true
# 是否启用用户行为分析
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ========== 开发工具 ==========
# 是否显示调试面板（仅开发环境）
NEXT_PUBLIC_SHOW_DEBUG_PANEL=true
