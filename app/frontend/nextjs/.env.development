# SuperCrypto 本地开发环境配置
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_BACKEND_NETWORK=hardhat
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=1077734b9cd1525796d5d6e659cd8b11
NEXT_PUBLIC_SUPPORTED_CHAIN_IDS=31337,1,11155111
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs
NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=true
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_SHOW_DEBUG_PANEL=true

# Mock Token 合约地址 — 由后端 /public/contracts/addresses 接口动态提供
# 仅在后端不可用时作为 fallback，正常流程无需配置
# NEXT_PUBLIC_MOCK_USDT_ADDRESS=
# NEXT_PUBLIC_MOCK_USDC_ADDRESS=

# GOD_MODE: 开发环境下绕过所有权限检查 (wallet, kyc, admin, accessToken)
# 设置为 true 启用，删除或设置为 false 禁用
# 注意: 生产环境会强制禁用此功能，无论此变量如何设置
NEXT_PUBLIC_GOD_MODE=false
