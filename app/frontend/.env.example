# ============================================
# SuperCrypto Frontend Environment Configuration
# ============================================
# Copy this file to .env.local for local development
# or .env.production for production builds

# --------------------------------------------
# Environment
# --------------------------------------------
NEXT_PUBLIC_ENV=development
NODE_ENV=development

# --------------------------------------------
# API Configuration
# --------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# --------------------------------------------
# Blockchain Configuration
# --------------------------------------------
# RPC Configuration
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_CHAIN_ID=31337

# Supported Networks (comma-separated chain IDs)
NEXT_PUBLIC_SUPPORTED_CHAIN_IDS=31337,1,11155111

# Network Names (for UI display)
NEXT_PUBLIC_NETWORK_NAMES=Hardhat,Ethereum Mainnet,Sepolia Testnet

# Block Explorer URLs
NEXT_PUBLIC_EXPLORER_URL=http://localhost:8545
NEXT_PUBLIC_EXPLORER_URL_MAINNET=https://etherscan.io
NEXT_PUBLIC_EXPLORER_URL_SEPOLIA=https://sepolia.etherscan.io

# --------------------------------------------
# Contract Addresses
# --------------------------------------------
# Treasury Multisig Contract
NEXT_PUBLIC_TREASURY_MULTISIG_ADDRESS=0x0000000000000000000000000000000000000000

# Address Provider
NEXT_PUBLIC_ADDRESS_PROVIDER_ADDRESS=0x0000000000000000000000000000000000000000

# Token Contracts
NEXT_PUBLIC_USDT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_USDC_ADDRESS=0x0000000000000000000000000000000000000000

# RWA Token
NEXT_PUBLIC_RWA_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Platform Token (PLT)
NEXT_PUBLIC_PLATFORM_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Subscription Contract
NEXT_PUBLIC_SUBSCRIPTION_ADDRESS=0x0000000000000000000000000000000000000000

# Staking Contract
NEXT_PUBLIC_STAKING_ADDRESS=0x0000000000000000000000000000000000000000

# KYC Manager
NEXT_PUBLIC_KYC_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000

# --------------------------------------------
# Wallet & Authentication
# --------------------------------------------
# WalletConnect Project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# RainbowKit Configuration
NEXT_PUBLIC_RAINBOWKIT_APP_NAME=SuperCrypto
NEXT_PUBLIC_RAINBOWKIT_APP_DESCRIPTION="RWA Tokenized Investment Platform"

# --------------------------------------------
# Treasury & Redemption Settings
# --------------------------------------------
# Minimum redemption amount in UI
NEXT_PUBLIC_MIN_REDEMPTION_AMOUNT=100

# Maximum redemption amount in UI
NEXT_PUBLIC_MAX_REDEMPTION_AMOUNT=1000000

# Redemption token decimals (USDT = 6)
NEXT_PUBLIC_REDEMPTION_TOKEN_DECIMALS=6

# Display currency
NEXT_PUBLIC_CURRENCY=USDT

# --------------------------------------------
# Feature Flags
# --------------------------------------------
# Enable redemption feature
NEXT_PUBLIC_ENABLE_REDEMPTION=true

# Enable staking feature
NEXT_PUBLIC_ENABLE_STAKING=true

# Enable liquidity mining
NEXT_PUBLIC_ENABLE_LIQUIDITY_MINING=true

# Enable KYC
NEXT_PUBLIC_ENABLE_KYC=true

# Show debug panel (DEV ONLY)
NEXT_PUBLIC_SHOW_DEBUG_PANEL=true

# Enable testnet faucet
NEXT_PUBLIC_ENABLE_FAUCET=true

# God Mode (bypass all checks - DEV ONLY!)
NEXT_PUBLIC_GOD_MODE=false

# --------------------------------------------
# UI Configuration
# --------------------------------------------
# Default language
NEXT_PUBLIC_DEFAULT_LANGUAGE=zh-CN

# Available languages
NEXT_PUBLIC_LANGUAGES=zh-CN,en-US

# Theme
NEXT_PUBLIC_DEFAULT_THEME=light

# --------------------------------------------
# IPFS & Content
# --------------------------------------------
# IPFS Gateway
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs

# Assets base URL
NEXT_PUBLIC_ASSETS_URL=

# --------------------------------------------
# Analytics & Monitoring
# --------------------------------------------
# Google Analytics
NEXT_PUBLIC_GA_ID=

# Plausible Analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Enable performance monitoring
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=true

# Enable error reporting (Sentry)
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=true
NEXT_PUBLIC_SENTRY_DSN=

# Enable analytics
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# --------------------------------------------
# External Links
# --------------------------------------------
# Documentation URL
NEXT_PUBLIC_DOCS_URL=https://docs.supercrypto.io

# Support URL
NEXT_PUBLIC_SUPPORT_URL=https://support.supercrypto.io

# Terms of Service
NEXT_PUBLIC_TOS_URL=/terms

# Privacy Policy
NEXT_PUBLIC_PRIVACY_URL=/privacy

# --------------------------------------------
# Development Settings
# --------------------------------------------
# Mock API responses
NEXT_PUBLIC_MOCK_API=false

# API timeout (ms)
NEXT_PUBLIC_API_TIMEOUT=30000

# Enable React Query devtools
NEXT_PUBLIC_ENABLE_RQ_DEVTOOLS=false
